# Copy to .local/ai.env (gitignored) and fill the key you will use.
# ingest:sync / ingest:source load that file automatically if it exists.
# Variables already set in the process environment are never overwritten.

# Gemini / Gemma: one API key, preference-ordered pool.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it
# An existing GEMINI_MODEL still pins one model if GEMINI_MODELS is unset.
# GEMINI_MODEL=gemini-3.1-flash-lite
# Operational budgets already include a safety margin; check your AI Studio quota.
# GEMINI_MODEL_RPM=gemini-3.1-flash-lite:12,gemini-3.5-flash-lite:12,gemma-4-26b-a4b-it:24,gemma-4-31b-it:24
# GEMINI_MODEL_TPM=gemini-3.1-flash-lite:200000,gemini-3.5-flash-lite:200000,gemma-4-26b-a4b-it:12800,gemma-4-31b-it:12800
# GEMINI_MODEL_RPD=gemini-3.1-flash-lite:450,gemini-3.5-flash-lite:450,gemma-4-26b-a4b-it:12960,gemma-4-31b-it:12960
# Optional global override of model RPM defaults:
# GEMINI_RPM=12
# GEMINI_CONCURRENCY=4
# Optional HTTP budget per run, including retries:
# GEMINI_MAX_REQUESTS=200
# on/off; off means no cache reads or writes:
# GEMINI_CACHE=on
# Shared quota/cache/lock directory for this project:
# GEMINI_STATE_DIR=.local/ai

# OpenAI (alternative; only used when AI_PROVIDER=openai or when
# AI_PROVIDER is unset and OPENAI_API_KEY is present)
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
