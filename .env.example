# Copy to .local/ai.env (gitignored) and fill the key you will use.
# ingest:sync / ingest:source load that file automatically if it exists.
# Variables already set in the process environment are never overwritten.

# Pool-wide controls. Routes are stable provider:model identifiers.
# Required for the multi-provider production pool. Fail closed if not exactly true.
AI_PROVIDER=pool
AI_ZERO_COST_ONLY=true
# AI_ROUTE=gemini:gemini-3.8-flash
# AI_MAX_REQUESTS=200
# AI_CACHE=on
# AI_STATE_DIR=.local/ai

# Gemini / Gemma: one API key, preference-ordered pool.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it
# An existing GEMINI_MODEL still pins one model if GEMINI_MODELS is unset.
# GEMINI_MODEL=gemini-3.8-flash
# Operational budgets already include a safety margin; check your AI Studio quota.
# GEMINI_MODEL_RPM=gemini-3.8-flash:4,gemini-3.7-flash:4,gemini-3.6-flash:4,gemini-3.5-flash:4,gemini-3-flash-preview:4,gemini-3.5-flash-lite:12,gemini-3.1-flash-lite:12,gemma-4-31b-it:24,gemma-4-26b-a4b-it:24
# GEMINI_MODEL_TPM=gemini-3.8-flash:200000,gemini-3.7-flash:200000,gemini-3.6-flash:200000,gemini-3.5-flash:200000,gemini-3-flash-preview:200000,gemini-3.5-flash-lite:200000,gemini-3.1-flash-lite:200000,gemma-4-31b-it:12800,gemma-4-26b-a4b-it:12800
# GEMINI_MODEL_RPD=gemini-3.8-flash:18,gemini-3.7-flash:18,gemini-3.6-flash:18,gemini-3.5-flash:18,gemini-3-flash-preview:18,gemini-3.5-flash-lite:450,gemini-3.1-flash-lite:450,gemma-4-31b-it:12960,gemma-4-26b-a4b-it:12960
# Optional global override of model RPM defaults:
# GEMINI_RPM=12
# GEMINI_CONCURRENCY=8
# Legacy Gemini aliases (prefer the pool-wide AI_* variables above).
# Optional HTTP budget per run, including retries:
# GEMINI_MAX_REQUESTS=200
# on/off; off means no cache reads or writes:
# GEMINI_CACHE=on
# Shared quota/cache/lock directory for this project:
# GEMINI_STATE_DIR=.local/ai

# OpenAI (alternative; only used when AI_PROVIDER=openai or when
# AI_PROVIDER is unset and OPENAI_API_KEY is present)
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Groq. Enabled only when the key AND explicit Free-tier confirmation exist.
# GROQ_API_KEY is a GitHub secret. GROQ_FREE_TIER_CONFIRMED and the optional
# GROQ_MODEL_* / GROQ_* concurrent-interval limits are GitHub repository
# variables (vars.*), never secrets.
# GROQ_API_KEY=
# GROQ_FREE_TIER_CONFIRMED=true
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Optional account-specific conservative overrides (model:integer pairs).
# Unset keeps the published Free defaults (rpm 30 / tpm 8000 / rpd 1000)
# and does not apply extra concurrency/interval pressure.
# Production reads vars.GROQ_MODEL_RPM, vars.GROQ_MODEL_TPM, vars.GROQ_MODEL_RPD
# and the pressure vars below. See "Pressure controls" at the end of this file.
# GROQ_MODEL_RPM=openai/gpt-oss-120b:30
# GROQ_MODEL_TPM=openai/gpt-oss-120b:8000
# GROQ_MODEL_RPD=openai/gpt-oss-120b:1000
# GROQ_MODEL_MAX_CONCURRENT=openai/gpt-oss-120b:1
# GROQ_MODEL_MIN_INTERVAL_MS=openai/gpt-oss-120b:2000
# GROQ_MAX_CONCURRENT=1
# GROQ_MIN_INTERVAL_MS=2000

# Mistral. Keep the organization in Free mode with PAYG disabled.
# MISTRAL_API_KEY is a GitHub secret. Confirmations are vars.*.
# Production model IDs and conservative TPM/interval defaults live in code
# (Clásica Madrid account, verified September 2026 — not universal Mistral
# quotas). Unset MISTRAL_MODELS / MISTRAL_MODEL_* / MISTRAL_* uses those
# defaults. Env vars remain emergency overrides and win over the repo.
# Production may read vars.MISTRAL_MODELS and vars.MISTRAL_MODEL_* if set.
# MISTRAL_API_KEY=
# MISTRAL_FREE_MODE_CONFIRMED=true
# MISTRAL_MODELS=ministral-14b-2512,ministral-8b-2512
# Optional emergency overrides (model:integer pairs). Unset = code defaults:
#   ministral-14b-2512 tpm 937500 / maxConcurrent 1 / minIntervalMs 2100
#   ministral-8b-2512  tpm 625000 / maxConcurrent 1 / minIntervalMs 350
# MISTRAL_MODEL_TPM=ministral-14b-2512:937500,ministral-8b-2512:625000
# MISTRAL_MODEL_MAX_CONCURRENT=ministral-14b-2512:1,ministral-8b-2512:1
# MISTRAL_MODEL_MIN_INTERVAL_MS=ministral-14b-2512:2100,ministral-8b-2512:350
# MISTRAL_MODEL_RPM=ministral-14b-2512:1
# MISTRAL_MODEL_RPD=ministral-14b-2512:100
# MISTRAL_MAX_CONCURRENT=1
# MISTRAL_MIN_INTERVAL_MS=2100

# Z.AI. Under zero-cost mode only the exact allowlisted Flash IDs are accepted.
# ZAI_API_KEY is a GitHub secret. Optional ZAI_MODEL_* / ZAI_* limits are vars.*.
# Production defaults to providerMaxConcurrent=1 in code because 1302 is high
# concurrency, not daily quota. Unset ZAI_MAX_CONCURRENT uses that default.
# ZAI_API_KEY=
# ZAI_MODELS=glm-4.7-flash,glm-4.5-flash
# ZAI_MODEL_RPM=glm-4.7-flash:1
# ZAI_MODEL_TPM=glm-4.7-flash:10000
# ZAI_MODEL_RPD=glm-4.7-flash:100
# ZAI_MODEL_MAX_CONCURRENT=glm-4.7-flash:1
# ZAI_MODEL_MIN_INTERVAL_MS=glm-4.7-flash:2000
# ZAI_MAX_CONCURRENT=1
# ZAI_MIN_INTERVAL_MS=2000

# Cloudflare Workers AI. Reuse the existing token/account ID; do not create
# separate credentials and do not enable Workers Paid or AI Gateway billing.
# Optional CLOUDFLARE_MODEL_* / CLOUDFLARE_* limits are vars.*, never secrets.
# No invented RPM/RPD defaults; unset means no extra quota or pressure caps.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_WORKERS_FREE_CONFIRMED=true
# CLOUDFLARE_MODELS=@cf/zai-org/glm-4.7-flash,@cf/google/gemma-4-26b-a4b-it
# CLOUDFLARE_MODEL_RPM=@cf/zai-org/glm-4.7-flash:1
# CLOUDFLARE_MODEL_TPM=@cf/zai-org/glm-4.7-flash:10000
# CLOUDFLARE_MODEL_RPD=@cf/zai-org/glm-4.7-flash:100
# CLOUDFLARE_MODEL_MAX_CONCURRENT=@cf/zai-org/glm-4.7-flash:1
# CLOUDFLARE_MODEL_MIN_INTERVAL_MS=@cf/zai-org/glm-4.7-flash:2000
# CLOUDFLARE_MAX_CONCURRENT=1
# CLOUDFLARE_MIN_INTERVAL_MS=2000

# Pressure controls (generic scheduler; no per-provider hardcoded quotas in the
# scheduler itself). Versioned production defaults for Mistral models and Z.AI
# concurrency live in code; unset env uses those defaults. Env still wins.
# Model overrides are comma-separated model:integer pairs.
#   maxConcurrent            HTTP in-flight per route (`*_MODEL_MAX_CONCURRENT`)
#   minIntervalMs            minimum gap between request starts of one route
#                            (`*_MODEL_MIN_INTERVAL_MS`)
#   providerMaxConcurrent    HTTP in-flight across every route of that provider
#                            (`*_MAX_CONCURRENT`)
#   providerMinIntervalMs    minimum gap between request starts of that provider
#                            (`*_MIN_INTERVAL_MS`)
# 0 keeps the scheduler semantics already implemented:
#   rpm/tpm/rpd/maxConcurrent/providerMaxConcurrent = 0 disables those routes;
#   minIntervalMs/providerMinIntervalMs = 0 does not disable, it only adds no
#   extra spacing. Do not use 0 as a synonym for "unset".

# Optional fetch relay. GitHub stores the URL as repository variable
# vars.INGEST_FETCH_RELAY_URL (not a secret) and the token as secret
# INGEST_FETCH_RELAY_TOKEN. Only sources with useFetchRelay in the registry
# use it; ordinary sources ignore these. A half-configured relay fails those
# sources visibly. See infra/fetch-relay/.
# INGEST_FETCH_RELAY_URL=https://clasica-madrid-fetch-relay.example.workers.dev
# INGEST_FETCH_RELAY_TOKEN=
