---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_DESCRIPTION, DEFAULT_TITLE, SITE_NAME } from '../lib/presentation/constants.ts';
import { publicUrl } from '../lib/presentation/urls.ts';
import { serializeJsonForScript } from '../lib/util/json-script.ts';

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  indexable?: boolean;
  jsonLd?: Record<string, unknown>[] | Record<string, unknown>;
};

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  canonicalPath = '/',
  indexable = true,
  jsonLd,
} = Astro.props;

const pageTitle = title === DEFAULT_TITLE || title.includes(SITE_NAME) ? title : `${title} — ${SITE_NAME}`;
const canonical = indexable ? publicUrl(canonicalPath) : null;
const jsonLdScript = jsonLd ? serializeJsonForScript(jsonLd) : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    {indexable ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {
      jsonLdScript && (
        <script is:inline type="application/ld+json" set:html={jsonLdScript}></script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" class="page">
      <slot />
    </main>
    <Footer />
  </body>
</html>
