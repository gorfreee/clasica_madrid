  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="10.5" cy="10.5" r="6.25"></circle>
  <path d="M15.4 15.4 20.5 20.5"></path>
</svg>
