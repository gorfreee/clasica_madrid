---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Agenda', current: path === '/' },
  { href: '/lugares', label: 'Lugares', current: path === '/lugares' || path.startsWith('/lugares/') },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-mark" href="/" aria-label="Clásica Madrid, ir a la agenda">
      <span class="site-mark__siglum" aria-hidden="true">CM</span>
      <span class="site-mark__name">Clásica<br />Madrid</span>
    </a>
    <nav aria-label="Principal">
      <ul class="nav-list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={link.current ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="site-header__edition" aria-hidden="true">Agenda · Madrid</p>
  </div>
</header>
