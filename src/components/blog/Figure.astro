---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  creditUrl?: string;
};

const { src, alt, caption, credit, creditUrl } = Astro.props;
if (creditUrl && !credit) {
  throw new Error('Figure: creditUrl exige credit');
}
if (!alt.trim()) {
  throw new Error('Figure: alt es obligatorio');
}
---

<figure class="article-figure">
  <Image
    src={src}
    alt={alt}
    widths={[480, 768, 1200]}
    sizes="(max-width: 760px) 100vw, 40rem"
    loading="lazy"
    decoding="async"
  />
  {
    (caption || credit) && (
      <figcaption>
        {caption && <span>{caption}</span>}
        {credit && (
          <span>
            {creditUrl ? (
              <a href={creditUrl} target="_blank" rel="noopener noreferrer">
                {credit}
                <span class="visually-hidden"> (se abre en otra pestaña)</span>
              </a>
            ) : (
              credit
            )}
          </span>
        )}
      </figcaption>
    )
  }
</figure>

<style>
  .article-figure {
    margin: 1.5rem 0;
  }
</style>
