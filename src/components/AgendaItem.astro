---
import type { AgendaItemModel } from '../lib/presentation/agenda.ts';

type Props = {
  item: AgendaItemModel;
  showDate?: boolean;
};

const { item, showDate = false } = Astro.props;
const timeLabel = item.time ?? 'Hora no indicada';
---
{/* Contrato UI interno: [data-occurrence-id] lo usa agenda-client.ts. */}

<article class="agenda-item" data-occurrence-id={item.occurrenceId}>
  <p class="agenda-item__time">
    {showDate && <time class="agenda-item__date" datetime={item.date} aria-label={item.dateLabel}>{item.dateShortLabel}</time>}
    <span aria-label={item.time ? `A las ${item.time}` : 'Hora no indicada'}>{timeLabel}</span>
  </p>
  <div class="agenda-item__main">
    <h3 class="agenda-item__title">
      <a href={item.href}>{item.title}</a>
    </h3>
    {item.contextLine && <p class="agenda-item__people">{item.contextLine}</p>}
    {item.musicLine && <p class="agenda-item__music">{item.musicLine}</p>}
    <p class="agenda-item__venue agenda-item__venue--mobile">
      <a href={item.venueHref}>{item.venueName}</a>
      {item.showMunicipality && <span> · {item.municipality}</span>}
    </p>
    <p class="agenda-item__signals">
      {item.formats[0] && <span>{item.formats[0].label}</span>}
      {item.access.id === 'free' && <strong>Entrada libre</strong>}
    </p>
  </div>
  <div class="agenda-item__place">
    <p class="agenda-item__venue">
      <a href={item.venueHref}>{item.venueName}</a>
      {item.showMunicipality && <span> · {item.municipality}</span>}
    </p>
    {item.seriesName && <p class="agenda-item__series">{item.seriesName}</p>}
  </div>
</article>
