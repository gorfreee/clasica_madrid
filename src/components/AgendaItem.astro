---
import type { AgendaItemModel } from '../lib/presentation/agenda.ts';

type Props = {
  item: AgendaItemModel;
};

const { item } = Astro.props;
const timeLabel = item.time ?? '—';
const timeA11y = item.time ? `A las ${item.time}` : 'Hora no indicada';
---
{/* Contrato UI interno: [data-occurrence-id] lo usa agenda-client.ts. */}

<article class="agenda-item" data-occurrence-id={item.occurrenceId}>
  <p class:list={['agenda-item__when', { 'is-unknown': !item.time }]}>
    <time datetime={`${item.date}${item.time ? `T${item.time}` : ''}`} aria-label={timeA11y}>{timeLabel}</time>
  </p>
  <div class="agenda-item__body">
    <div class="agenda-item__main">
      <h3 class="agenda-item__title">
        <a href={item.href}>{item.title}</a>
      </h3>
      {item.contextLine && <p class="agenda-item__context">{item.contextLine}</p>}
    </div>
    <p class="agenda-item__meta agenda-item__venue">
      <a href={item.venueHref}>{item.venueName}</a>
      {item.showMunicipality && <span> · {item.municipality}</span>}
      {item.isFree && (
        <>
          {' '}
          <span class="agenda-item__libre">libre</span>
        </>
      )}
    </p>
  </div>
</article>
