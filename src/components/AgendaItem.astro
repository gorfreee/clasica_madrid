---
import type { AgendaItemModel } from '../lib/presentation/agenda.ts';

type Props = { item: AgendaItemModel };

const { item } = Astro.props;
const timeLabel = item.time ?? 'Hora por confirmar';
const people = item.performers.length > 0 ? item.performers : item.composers;
const peopleLabel = people.slice(0, 3).join(' · ');
const remainingPeople = Math.max(people.length - 3, 0);
const isFree = item.access.id === 'free';
---
{/* Contrato UI interno: [data-occurrence-id] lo usa agenda-client.ts. */}

<article class="agenda-item" data-occurrence-id={item.occurrenceId}>
  <div class="agenda-item__time">
    <time datetime={`${item.date}${item.time ? `T${item.time}` : ''}`}>{timeLabel}</time>
    <span class="agenda-item__date">{item.dateLabel}</span>
  </div>
  <div class="agenda-item__main">
    <h3 class="agenda-item__title"><a href={item.href}>{item.title}</a></h3>
    {peopleLabel && (
      <p class="agenda-item__people">
        {peopleLabel}{remainingPeople > 0 && <span> +{remainingPeople}</span>}
      </p>
    )}
    {item.seriesName && <p class="agenda-item__series">{item.seriesName}</p>}
  </div>
  <p class="agenda-item__venue">
    <a href={item.venueHref}>{item.venueName}</a>
    {item.showMunicipality && <span>{item.municipality}</span>}
  </p>
  <div class="agenda-item__signal">
    {isFree ? (
      <span class="access-signal access-signal--free"><i aria-hidden="true"></i> Gratis</span>
    ) : item.access.id === 'unknown' ? (
      <span class="access-signal">Acceso por confirmar</span>
    ) : (
      <span class="access-signal">De pago</span>
    )}
    {item.formats[0] && <span class="agenda-item__format">{item.formats[0].label}</span>}
  </div>
</article>
