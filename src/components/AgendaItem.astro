---
import type { AgendaItemModel } from '../lib/presentation/agenda.ts';

type Props = {
  item: AgendaItemModel;
  showDate?: boolean;
};

const { item, showDate = true } = Astro.props;
const timeLabel = item.time ?? 'Hora por confirmar';
const context = item.performers.length > 0 ? item.performers : item.composers;
const signal = item.formats[0] ?? item.kind;
---
{/* Contrato UI interno: [data-occurrence-id] lo usa agenda-client.ts. */}

<article class="agenda-item" data-occurrence-id={item.occurrenceId}>
  <p class="agenda-item__when">
    {showDate && <time datetime={item.date}>{item.dateLabel}</time>}
    <span aria-label={item.time ? `A las ${item.time}` : 'Hora por confirmar'}>{timeLabel}</span>
  </p>
  <div class="agenda-item__main">
    <h3 class="agenda-item__title"><a href={item.href}>{item.title}</a></h3>
    {context.length > 0 && <p class="agenda-item__people">{context.join(', ')}</p>}
    {item.seriesName && <p class="agenda-item__series">{item.seriesName}</p>}
  </div>
  <p class="agenda-item__venue">
    <a href={item.venueHref}>{item.venueName}</a>
    {item.showMunicipality && <span> / {item.municipality}</span>}
  </p>
  <p class="agenda-item__signal">
    {item.access.id === 'free' && <span class="signal-free">Entrada libre</span>}
    {item.access.id !== 'free' && <span>{signal.label}</span>}
  </p>
</article>
