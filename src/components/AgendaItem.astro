---
import type { AgendaItemModel } from '../lib/presentation/agenda.ts';

type Props = {
  item: AgendaItemModel;
};

const { item } = Astro.props;
const timeLabel = item.time ?? 'Sin hora';
---
{/* Contrato UI interno: [data-occurrence-id] lo usa agenda-client.ts. */}

<article class="agenda-item" data-occurrence-id={item.occurrenceId}>
  <p class:list={['agenda-item__time', { 'agenda-item__time--unknown': !item.time }]}>
    <time
      datetime={`${item.date}${item.time ? `T${item.time}` : ''}`}
      aria-label={item.time ? `${item.dateLabel}, a las ${item.time}` : `${item.dateLabel}, hora no indicada`}
    >{timeLabel}</time>
  </p>
  <div class="agenda-item__main">
    <h3 class="agenda-item__title">
      <a href={item.href}>{item.title}</a>
    </h3>
    {item.contextLine && <p class="agenda-item__context">{item.contextLine}</p>}
    {item.descriptorLine && <p class="agenda-item__descriptor">{item.descriptorLine}</p>}
  </div>
  <p class="agenda-item__place">
    <a href={item.venueHref} aria-label={`Ver lugar: ${item.venueName}`}>{item.venueName}</a>
    {item.showMunicipality && <span class="agenda-item__municipality">{item.municipality}</span>}
  </p>
  <p class="agenda-item__signals">
    {item.access.id === 'free' && <span class="agenda-item__free">Entrada libre</span>}
    {item.formats[0] && <span>{item.formats[0].label}</span>}
  </p>
</article>
