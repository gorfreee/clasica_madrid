---
import type { AgendaDayModel } from '../lib/presentation/agenda.ts';
import AgendaItem from './AgendaItem.astro';

type Props = {
  days: AgendaDayModel[];
};

const { days } = Astro.props;
---
{/* Contrato UI interno: [data-agenda-list] y [data-agenda-day] los usa agenda-client.ts. */}

<div class="agenda" data-agenda-list>
  {
    days.map((day) => (
      <>
        {day.startsMonth && <p class="agenda-month" data-agenda-month={day.date.slice(0, 7)}>{day.monthLabel}</p>}
        <section
          class:list={['agenda-day', { 'agenda-day--today': day.isToday }]}
          data-agenda-day={day.date}
          data-agenda-month-key={day.date.slice(0, 7)}
          aria-labelledby={`dia-${day.date}`}
        >
          <h2 id={`dia-${day.date}`} class="agenda-day__title">
            <time datetime={day.date}>
              {(day.isToday || day.isTomorrow) && (
                <span class="agenda-day__relative">{day.isToday ? 'Hoy' : 'Mañana'}</span>
              )}
              <span>{day.compactDateLabel}</span>
            </time>
            <span class="agenda-day__count" aria-label={day.items.length === 1 ? '1 concierto' : `${day.items.length} conciertos`}>
              {day.items.length}
            </span>
          </h2>
          <div class="agenda-day__list">
            {day.items.map((item) => (
              <AgendaItem item={item} />
            ))}
          </div>
        </section>
      </>
    ))
  }
</div>
