---
import type { AgendaDayModel } from '../lib/presentation/agenda.ts';
import AgendaItem from './AgendaItem.astro';

type Props = {
  days: AgendaDayModel[];
};

const { days } = Astro.props;
---
{/* Contrato UI interno: [data-agenda-list] y [data-agenda-day] los usa agenda-client.ts. */}

<div class="agenda" data-agenda-list>
  {
    days.map((day) => (
      <section
        class="agenda-day"
        data-agenda-day={day.date}
        data-empty-today={day.isEmpty && day.isToday ? '' : undefined}
        aria-labelledby={`dia-${day.date}`}
      >
        {
          day.monthBreak && (
            <p class="month-break">
              <span class="visually-hidden">Cambio de mes. </span>
              {day.monthLabel}
            </p>
          )
        }
        <h2 id={`dia-${day.date}`} class="agenda-day__title">
          <span class:list={['rehearsal', { 'rehearsal--word': day.isToday || day.isTomorrow }]}>
            {day.isToday ? 'Hoy' : day.isTomorrow ? 'Mañana' : day.dayNumber}
          </span>
          <time class="agenda-day__weekday" datetime={day.date}>
            {day.weekdayLabel}
          </time>
        </h2>
        {
          day.isEmpty ? (
            <p class="agenda-day__empty">Hoy no hay conciertos publicados.</p>
          ) : (
            <div class="agenda-day__list">
              {day.items.map((item) => (
                <AgendaItem item={item} />
              ))}
            </div>
          )
        }
      </section>
    ))
  }
</div>
