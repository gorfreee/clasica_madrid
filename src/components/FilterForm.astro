---
import type { AgendaPageModel } from '../lib/presentation/agenda.ts';

type Props = {
  model: AgendaPageModel;
};

const { model } = Astro.props;
---
{/* Contrato UI interno: [data-agenda-filters] y [data-clear-filters] los usa agenda-client.ts. */}

<section class="filters" aria-labelledby="busqueda-titulo">
  <h2 id="busqueda-titulo" class="visually-hidden">Buscar y filtrar conciertos</h2>
  <form class="filters__form" method="get" action="/" data-agenda-filters>
    <div class="search-line">
      <label class="search-field">
        <span class="visually-hidden">Buscar en el catálogo</span>
        <span class="search-field__number" aria-hidden="true">01</span>
        <input type="search" name="q" value={model.query} placeholder="Obra, intérprete, compositor o lugar" />
      </label>
      <button class="search-submit" type="submit">Aplicar filtros</button>
    </div>

    <nav class="shortcuts" aria-label="Atajos de agenda">
      <span class="shortcuts__label">Ir a</span>
      {
        model.shortcuts.map((shortcut) => (
          <a href={shortcut.href} data-agenda-shortcut={shortcut.id}>{shortcut.label}</a>
        ))
      }
    </nav>

    <details class="filters__advanced">
      <summary>
        <span>Filtros</span>
        <span class="filters__summary-note">fecha, lugar, formato y más</span>
      </summary>
      <div class="filters__sheet">
        <div class="filters__grid">
          <label class="field">
            <span>Desde</span>
            <input type="date" name="from" value={model.from} />
          </label>
          <label class="field">
            <span>Hasta</span>
            <input type="date" name="to" value={model.to} />
          </label>
          {
            model.selectFilters.map((field) => (
              <label class="field">
                <span>{field.label}</span>
                <select name={field.name}>
                  {field.options.map((option) => (
                    <option value={option.value} selected={option.value === field.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
              </label>
            ))
          }
          <label class="field">
            <span>Compositor</span>
            <input
              type="text"
              name="composer"
              value={model.composer}
              list="composer-suggestions"
              autocomplete="off"
            />
            <datalist id="composer-suggestions">
              {model.composerSuggestions.map((name) => <option value={name} />)}
            </datalist>
          </label>
        </div>
        <div class="filters__actions">
          <button type="submit">Ver conciertos</button>
        </div>
      </div>
    </details>

    <div class="active-filters" data-active-filters hidden aria-label="Filtros activos"></div>
    <div class="filters__clear-row">
      <a class="filters__clear" href="/" data-clear-filters hidden>Limpiar todo</a>
    </div>
  </form>
  <noscript>
    <p class="filters__noscript">Los filtros de la URL se aplican con JavaScript.</p>
  </noscript>
</section>
