---
import type { AgendaPageModel } from '../lib/presentation/agenda.ts';
import '../styles/agenda-toolbar.css';

type Props = {
  model: AgendaPageModel;
};

const { model } = Astro.props;
---
{/* Contrato UI interno: [data-agenda-filters], [data-agenda-shortcuts], [data-result-count] y [data-clear-filters] los usa agenda-client.ts. */}

<section class="filters" aria-labelledby="buscar-titulo">
  <form class="filters__form" method="get" action="/" data-agenda-filters>
    <h2 id="buscar-titulo" class="visually-hidden">Buscar y filtrar la agenda</h2>
    <div class="search-line">
      <label class="search-field">
        <span class="visually-hidden">Buscar en la agenda</span>
        <input
          type="search"
          name="q"
          value={model.query}
          data-search-placeholder-wide="Busca conciertos, intérpretes, compositores o lugares"
          data-search-placeholder-narrow="Busca conciertos, compositores..."
          placeholder="Busca conciertos, compositores..."
        />
      </label>
      <button class="search-submit" type="submit" aria-label="Aplicar filtros">
        <span class="search-submit__compact" aria-hidden="true">→</span>
        <span class="search-submit__label">Buscar</span>
      </button>
    </div>

    <div class="filters__toolbar">
      <nav class="shortcuts" aria-label="Accesos rápidos de agenda" data-agenda-shortcuts>
        {model.shortcuts.map((shortcut) => (
          <a class:list={["shortcut", { "shortcut--emphasis": shortcut.emphasis }]} href={shortcut.href}>
            {shortcut.label}
          </a>
        ))}
      </nav>

      <details class="filters__advanced">
        <summary>
          <span>Filtros</span>
          <span class="filters__summary-mark" aria-hidden="true">+</span>
        </summary>
        <div class="filters__panel">
          <div class="filters__grid">
            <label class="field">
              <span>Desde</span>
              <input type="date" name="from" value={model.from} />
            </label>
            <label class="field">
              <span>Hasta</span>
              <input type="date" name="to" value={model.to} />
            </label>
            {
              model.selectFilters.map((field) => (
                <label class="field">
                  <span>{field.label}</span>
                  <select name={field.name}>
                    {field.options.map((option) => (
                      <option value={option.value} selected={option.value === field.value}>
                        {option.label}
                      </option>
                    ))}
                  </select>
                </label>
              ))
            }
            <label class="field">
              <span>Compositor</span>
              <input
                type="text"
                name="composer"
                value={model.composer}
                list="composer-suggestions"
                autocomplete="off"
                placeholder="Nombre del compositor"
              />
              <datalist id="composer-suggestions">
                {model.composerSuggestions.map((name) => <option value={name} />)}
              </datalist>
            </label>
          </div>
          <div class="filters__actions">
            <button type="submit">Aplicar filtros</button>
          </div>
        </div>
      </details>

      <p class="result-count" data-result-count aria-live="polite">{model.resultCountLabel}</p>
    </div>

    <div class="filters__active-row">
      <div class="active-filters" data-active-filters aria-live="polite"></div>
      <a class="filters__clear" href="/" data-clear-filters hidden>Limpiar filtros</a>
    </div>
  </form>
  <noscript>
    <p class="filters__noscript">Los filtros de la URL se aplican con JavaScript.</p>
  </noscript>
</section>
