---
import type { PlaceAddressModel } from '../lib/presentation/place-address.ts';

type Props = {
  address: PlaceAddressModel;
  variant?: 'compact' | 'hero';
};

const { address, variant = 'compact' } = Astro.props;
---

<a
  class:list={['place-address', `place-address--${variant}`]}
  href={address.mapsUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={address.accessibleLabel}
>
  <span class="place-address__pin" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
      <circle cx="12" cy="10" r="2.5"></circle>
    </svg>
  </span>
  <span class="place-address__body">
    <span class="place-address__line">{address.line}</span>
    {address.locality && <span class="place-address__locality">{address.locality}</span>}
  </span>
  <span class="place-address__external" aria-hidden="true">↗</span>
</a>

<style>
  .place-address {
    display: flex;
    align-items: flex-start;
    gap: .42rem;
    width: fit-content;
    max-width: 100%;
    padding: .18rem 0;
    color: var(--muted);
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
    transition: color 140ms ease;
  }

  .place-address:hover {
    color: var(--blue);
    text-decoration: none;
  }

  .place-address:focus-visible {
    color: var(--blue);
    outline: 2px solid var(--blue);
    outline-offset: 4px;
    text-decoration: none;
  }

  .place-address__pin {
    display: block;
    flex: 0 0 auto;
    width: .95rem;
    height: .95rem;
    margin-top: .08rem;
  }

  .place-address__pin svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .place-address__body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: .1rem;
  }

  .place-address__line {
    overflow-wrap: anywhere;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: .16em;
    transition: text-decoration-color 140ms ease;
  }

  .place-address:hover .place-address__line,
  .place-address:focus-visible .place-address__line {
    text-decoration-color: currentColor;
  }

  .place-address__locality {
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    opacity: .78;
  }

  .place-address__external {
    flex: 0 0 auto;
    margin-left: .04rem;
    font-size: .72em;
    line-height: 1.45;
    opacity: .55;
  }

  .place-address--compact {
    font-size: .82rem;
  }

  .place-address--hero {
    margin: .85rem 0 .95rem;
    font-size: .94rem;
  }
</style>
