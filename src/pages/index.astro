---
import Layout from '../layouts/Layout.astro';
import FilterForm from '../components/FilterForm.astro';
import AgendaList from '../components/AgendaList.astro';
import EmptyState from '../components/EmptyState.astro';
import { loadAgendaPage } from '../lib/presentation/site.ts';
import { serializeJsonForScript } from '../lib/util/json-script.ts';

const model = await loadAgendaPage(Astro.url);
---

<Layout title={model.title} description={model.description} canonicalPath={model.canonicalPath} jsonLd={model.jsonLd}>
  <header class="agenda-intro">
    <div class="agenda-intro__copy">
      <p class="eyebrow">Agenda / Madrid</p>
      <h1>La clásica<br />que está sonando.</h1>
      <p class="lede">De las grandes salas a los pequeños espacios, todos los conciertos de música clásica reunidos en una sola agenda</p>
    </div>
    <div class="agenda-intro__graphic" aria-hidden="true"></div>
  </header>

  {
    model.isEmptyCatalog ? (
      <EmptyState
        title="Todavía no hay conciertos publicados"
        body="Estamos construyendo el catálogo. Cuando haya eventos verificados, aparecerán aquí en orden cronológico."
      />
    ) : !model.hasUpcoming ? (
      <EmptyState
        title="No hay conciertos próximos"
        body="El catálogo conserva eventos que ya han tenido lugar, pero ahora mismo no hay representaciones vigentes en la agenda."
      />
    ) : (
      <>
        <FilterForm model={model} />
        <div
          class="agenda-root"
          data-agenda-root
          data-upcoming-count={model.upcomingCount}
          data-agenda-complete={model.hasMoreOccurrences ? undefined : ''}
        >
          <AgendaList days={model.days} />
          {
            model.hasMoreOccurrences && (
              <div class="agenda-more" data-agenda-more>
                <p data-agenda-showing>{model.showingCountLabel}</p>
                <p data-agenda-load-error hidden role="alert">{model.fullAgendaLoadErrorMessage}</p>
                <button type="button" data-load-full-agenda>{model.showAllLabel}</button>
              </div>
            )
          }
          {/* data-result-count / data-no-results: contrato de agenda-client.ts */}
          <div data-no-results hidden>
            <EmptyState
              title="No hay conciertos con estos filtros"
              body="Prueba a quitar alguno o ampliar el intervalo de fechas."
            />
          </div>
          <script
            id="agenda-filter-data"
            type="application/json"
            is:inline
            set:html={serializeJsonForScript(model.filterIndex)}
          />
        </div>
        {/* #agenda-filter-data: contrato de agenda-client.ts; no eliminar en un rediseño */}
        <script>
          import { initAgendaFilters } from '../lib/presentation/agenda-client.ts';
          initAgendaFilters();
        </script>
      </>
    )
  }
</Layout>
