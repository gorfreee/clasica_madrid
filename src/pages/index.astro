---
import Layout from '../layouts/Layout.astro';
import FilterForm from '../components/FilterForm.astro';
import AgendaList from '../components/AgendaList.astro';
import EmptyState from '../components/EmptyState.astro';
import { loadAgendaPage } from '../lib/presentation/site.ts';
import { serializeJsonForScript } from '../lib/util/json-script.ts';

const model = await loadAgendaPage(Astro.url);
---

<Layout title={model.title} description={model.description} canonicalPath={model.canonicalPath}>
  <header class="page-header">
    <p class="eyebrow">Agenda</p>
    <h1>Música clásica en Madrid</h1>
    <p class="lede">
      Conciertos y eventos con fuente original. El catálogo cubre el municipio de Madrid y, cuando
      tiene sentido, municipios próximos.
    </p>
  </header>

  {
    model.isEmptyCatalog ? (
      <EmptyState
        title="Todavía no hay conciertos publicados"
        body="Estamos construyendo el catálogo. Cuando haya eventos verificados, aparecerán aquí en orden cronológico."
      />
    ) : !model.hasUpcoming ? (
      <EmptyState
        title="No hay conciertos próximos"
        body="El catálogo conserva eventos que ya han tenido lugar, pero ahora mismo no hay representaciones vigentes en la agenda."
      />
    ) : (
      <>
        <FilterForm model={model} />
        <p class="result-count" data-result-count aria-live="polite">
          {model.resultCountLabel}
        </p>
        <AgendaList days={model.days} />
        <div data-no-results hidden>
          <EmptyState
            title="Ningún concierto coincide con esos filtros"
            body="Prueba a quitar algún filtro o ampliar las fechas."
          />
        </div>
        <script
          id="agenda-filter-data"
          type="application/json"
          is:inline
          set:html={serializeJsonForScript(model.filterIndex)}
        />
        <script>
          import { initAgendaFilters } from '../lib/presentation/agenda-client.ts';
          initAgendaFilters();
        </script>
      </>
    )
  }
</Layout>
