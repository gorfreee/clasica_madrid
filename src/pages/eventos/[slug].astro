---
import Layout from '../../layouts/Layout.astro';
import HeroMotif from '../../components/HeroMotif.astro';
import PlaceAddress from '../../components/PlaceAddress.astro';
import { formatSourceCitationMeta } from '../../lib/presentation/labels.ts';
import { loadEventPage, loadEventStaticPaths } from '../../lib/presentation/site.ts';
import { AGENDA_PATH, eventPath } from '../../lib/presentation/urls.ts';

export async function getStaticPaths() {
  const paths = await loadEventStaticPaths();
  return paths.map((item) =>
    item.redirectTo
      ? { params: { slug: item.slug }, redirect: eventPath(item.redirectTo) }
      : { params: { slug: item.slug } },
  );
}

const { slug } = Astro.params;
if (!slug) {
  throw new Error('Falta el slug del evento');
}
const model = await loadEventPage(slug);
if (!model) {
  throw new Error(`Evento no encontrado: ${slug}`);
}
if (model.slug !== slug) {
  return Astro.redirect(model.canonicalPath, 301);
}
const primarySource = model.sources.find((source) => source.isPrimary) ?? model.sources[0];
const featured = model.featuredOccurrence;
---

<Layout title={model.documentTitle} description={model.description} canonicalPath={model.canonicalPath} jsonLd={model.jsonLd}>
  <article class="detail event-detail">
    <header class="detail-hero detail-hero--event">
      <a class="eyebrow" href={AGENDA_PATH}>{model.isPast ? 'Archivo / Evento pasado' : 'Agenda / Evento'}</a>
      {model.statusLabel !== 'Programado' && <p class="status-alert">{model.statusLabel}</p>}
      <h1>{model.title}</h1>
      {model.seriesName && <p class="detail-hero__series">{model.seriesKind} / {model.seriesName}</p>}
      <HeroMotif variant="event" class="detail-hero__motif" />
    </header>

    <dl class="event-facts fact-list">
      <div class="event-facts__when">
        <dt>{model.isPast ? 'Tuvo lugar' : 'Próxima función'}</dt>
        <dd>{featured ? <><time datetime={featured.startIso}>{featured.dateLabel}</time><strong>{featured.time ?? 'Hora por confirmar'}</strong></> : 'Fecha por confirmar'}</dd>
      </div>
      <div class="event-facts__venue">
        <dt>Lugar</dt>
        <dd><a href={model.venueHref}>{model.venueName}</a>{model.showMunicipality && <span> / {model.municipality}</span>}</dd>
        {model.spaceName && (
          <>
            <dt>Sala</dt>
            <dd class="event-facts__space">{model.spaceName}</dd>
          </>
        )}
        {model.placeAddress && (
          <>
            <dt class="visually-hidden">Dirección</dt>
            <dd class="event-facts__address">
              <PlaceAddress address={model.placeAddress} />
            </dd>
          </>
        )}
      </div>
      <div class="event-facts__access">
        <dt>Acceso</dt>
        <dd>{model.access.label}</dd>
      </div>
    </dl>

    {model.isPast && <p class="past-notice">Este evento ya ha tenido lugar. Conservamos la ficha como parte del archivo.</p>}
    {primarySource && <a class="official-link" href={primarySource.url} rel="noopener noreferrer"><span>Consulta entradas, condiciones y posibles cambios</span><strong>Ver información oficial ↗</strong></a>}

    <section class="detail-section" aria-labelledby="fechas-titulo">
      <div class="section-heading"><h2 id="fechas-titulo">Fechas</h2></div>
      <ol class="occurrence-list">
        {
          model.occurrences.map((occurrence) => (
            <li class:list={[{ 'is-cancelled': occurrence.isCancelled }]}>
              <time datetime={occurrence.startIso}>{occurrence.dateLabel}</time>
              <strong>{occurrence.time ?? 'Hora por confirmar'}</strong>
              {occurrence.isCancelled && <span>{occurrence.status}</span>}
            </li>
          ))
        }
      </ol>
    </section>

    {
      model.performers.length > 0 && (
        <section class="detail-section" aria-labelledby="interpretes-titulo">
          <div class="section-heading"><h2 id="interpretes-titulo">Intérpretes</h2></div>
          <ul class="editorial-list performer-list">
            {model.performers.map((performer) => (
              <li>
                <span>{performer.name}</span>
                {performer.role && <small>{performer.role}</small>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      model.composers.length > 0 && (
        <section class="detail-section" aria-labelledby="compositores-titulo">
          <div class="section-heading"><h2 id="compositores-titulo">Compositores</h2></div>
          <ul class="editorial-list">
            {model.composers.map((composer) => (
              <li>{composer}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      model.works.length > 0 && (
        <section class="detail-section programme" aria-labelledby="obras-titulo">
          <div class="section-heading"><h2 id="obras-titulo">Programa</h2></div>
          <ol class="programme-list">
            {model.works.map((work) => (
              <li>
                <span>{work.title}</span>
                {work.composerName && <small>{work.composerName}</small>}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section class="detail-section detail-meta" aria-labelledby="datos-titulo">
      <div class="section-heading"><h2 id="datos-titulo">Sobre el concierto</h2></div>
      <dl class="fact-list fact-list--compact">
        <div><dt>Programación</dt><dd>{model.kind.label}</dd></div>
        {model.formats.length > 0 && <div><dt>Formato</dt><dd>{model.formats.map((item) => item.label).join(', ')}</dd></div>}
        {model.eras.length > 0 && <div><dt>Época</dt><dd>{model.eras.map((item) => item.label).join(', ')}</dd></div>}
        {model.organizers.length > 0 && <div><dt>Organiza</dt><dd>{model.organizers.join(', ')}</dd></div>}
      </dl>
    </section>

    <section class="detail-section sources" aria-labelledby="fuentes-titulo">
      <div class="section-heading"><h2 id="fuentes-titulo">Fuentes</h2></div>
      <ul class="source-list">
        {
          model.sources.map((source) => (
            <li>
              <a href={source.url} rel="noopener noreferrer">
                {source.name}
              </a>
              <span>
                {formatSourceCitationMeta({
                  kindLabel: source.kind,
                  isPrimary: source.isPrimary,
                  checkedAt: source.checkedAt,
                })}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="verified">Última verificación: {model.lastVerifiedAt}</p>
    </section>
  </article>
</Layout>
