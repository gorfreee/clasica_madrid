---
import Layout from '../../layouts/Layout.astro';
import AgendaItem from '../../components/AgendaItem.astro';
import { loadEventPage, loadEventSlugs } from '../../lib/presentation/site.ts';

export async function getStaticPaths() {
  const slugs = await loadEventSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
if (!slug) {
  throw new Error('Falta el slug del evento');
}
const model = await loadEventPage(slug);
if (!model) {
  throw new Error(`Evento no encontrado: ${slug}`);
}

const statusNote = model.isCancelled
  ? 'Este concierto está cancelado.'
  : model.isPostponed
    ? 'Este concierto está aplazado.'
    : model.isPast
      ? 'Este evento ya ha tenido lugar.'
      : null;
---

<Layout title={model.title} description={model.description} canonicalPath={model.canonicalPath} jsonLd={model.jsonLd}>
  <article class="detail">
    <header class="page-header">
      <p class="eyebrow">{model.isPast ? 'Evento pasado' : 'Programa'}</p>
      <p class="detail__kicker">
        {model.headlineDateLabel && <span>{model.headlineDateLabel}</span>}
        <span>
          {model.headlineTime ?? (model.timeUnknown ? 'Hora por confirmar' : '')}
        </span>
        <span>
          <a href={model.venueHref}>{model.venueName}</a>
          {model.showMunicipality && <span> · {model.municipality}</span>}
        </span>
      </p>
      <h1>{model.title}</h1>
      {
        model.seriesName && (
          <p class="lede lede--compact">
            {model.seriesKind}: {model.seriesName}
          </p>
        )
      }
      {statusNote && <p class="detail__status">{statusNote}</p>}
      <div class="detail__actions">
        <a class="action" href={model.primarySourceUrl} rel="noopener noreferrer">
          Ver información oficial
        </a>
        <a class="action--ghost" href={model.mapsHref} rel="noopener noreferrer">
          Cómo llegar
        </a>
      </div>
    </header>

    <dl class="fact-list">
      <div>
        <dt>Acceso</dt>
        <dd>{model.isFree ? 'Libre' : model.access.label}</dd>
      </div>
      {
        model.formats.length > 0 && (
          <div>
            <dt>Formato</dt>
            <dd>{model.formats.map((item) => item.label).join(', ')}</dd>
          </div>
        )
      }
      {
        model.eras.length > 0 && (
          <div>
            <dt>Época</dt>
            <dd>{model.eras.map((item) => item.label).join(', ')}</dd>
          </div>
        )
      }
      {
        model.organizers.length > 0 && (
          <div>
            <dt>Organiza</dt>
            <dd>{model.organizers.join(', ')}</dd>
          </div>
        )
      }
    </dl>

    {
      model.venueAddress && (
        <p class="detail__address">
          {model.venueAddress}
          {model.showMunicipality ? `, ${model.municipality}` : ''}
        </p>
      )
    }

    <section aria-labelledby="fechas-titulo">
      <h2 id="fechas-titulo">Fechas</h2>
      <ol class="occurrence-list">
        {
          model.occurrences.map((occurrence) => (
            <li class:list={[{ 'is-cancelled': occurrence.isCancelled }]}>
              <time datetime={occurrence.startIso}>{occurrence.dateLabel}</time>
              <span>{occurrence.time ?? 'Hora por confirmar'}</span>
              {occurrence.isCancelled && <span> · {occurrence.status}</span>}
            </li>
          ))
        }
      </ol>
    </section>

    {
      model.performers.length > 0 && (
        <section aria-labelledby="interpretes-titulo">
          <h2 id="interpretes-titulo">Intérpretes</h2>
          <ul class="cast">
            {model.performers.map((performer) => (
              <li>
                <span>{performer.name}</span>
                {performer.role && <span class="cast__role">{performer.role}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      model.program.length > 0 && (
        <section aria-labelledby="obras-titulo">
          <h2 id="obras-titulo">Programa</h2>
          <div class="program">
            {model.program.map((group) => (
              <div>
                {group.composerName && <p class="program__composer">{group.composerName}</p>}
                <ul>
                  {group.works.map((work) => (
                    <li class="program__work">{work.title}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      model.composers.length > 0 && model.program.length === 0 && (
        <section aria-labelledby="compositores-titulo">
          <h2 id="compositores-titulo">Compositores</h2>
          <ul>
            {model.composers.map((composer) => (
              <li>{composer}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      model.relatedVenue.length > 0 && (
        <section class="related-list" aria-labelledby="mismo-lugar-titulo">
          <h2 id="mismo-lugar-titulo">En el mismo lugar</h2>
          <div class="agenda-day__list">
            {model.relatedVenue.map((item) => (
              <AgendaItem item={item} />
            ))}
          </div>
        </section>
      )
    }

    {
      model.relatedSeries.length > 0 && (
        <section class="related-list" aria-labelledby="mismo-ciclo-titulo">
          <h2 id="mismo-ciclo-titulo">Más del ciclo</h2>
          <div class="agenda-day__list">
            {model.relatedSeries.map((item) => (
              <AgendaItem item={item} />
            ))}
          </div>
        </section>
      )
    }

    <section aria-labelledby="fuentes-titulo">
      <h2 id="fuentes-titulo">Fuentes</h2>
      <ul class="source-list">
        {
          model.sources.map((source) => (
            <li>
              <a href={source.url} rel="noopener noreferrer">
                {source.name}
              </a>
              <span>
                {' '}
                · {source.kind}
                {source.isPrimary ? ' · principal' : ''} · comprobada {source.checkedAt}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="verified">Última verificación: {model.lastVerifiedAt}</p>
    </section>
  </article>
</Layout>
