---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import ArticleCTA from '../../components/blog/ArticleCTA.astro';
import Callout from '../../components/blog/Callout.astro';
import Figure from '../../components/blog/Figure.astro';
import Gallery from '../../components/blog/Gallery.astro';
import Quote from '../../components/blog/Quote.astro';
import RelatedArticles from '../../components/blog/RelatedArticles.astro';
import RelatedVenue from '../../components/blog/RelatedVenue.astro';
import UpcomingEvents from '../../components/blog/UpcomingEvents.astro';
import YouTubeEmbed from '../../components/blog/YouTubeEmbed.astro';
import { loadBlogEntries } from '../../lib/blog/load.ts';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { buildBlogPostingJsonLd } from '../../lib/presentation/json-ld.ts';
import {
  blogKindLabels,
  formatBlogDate,
  relatedArticles,
  toBlogPostMeta,
} from '../../lib/presentation/blog.ts';
import { blogPostPath } from '../../lib/presentation/urls.ts';

export async function getStaticPaths() {
  const entries = await loadBlogEntries();
  return entries
    .filter((entry) => entry.data.draft !== true)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
if (!entry || entry.data.draft === true) {
  throw new Error('Un borrador no puede generar una página pública');
}

const entries = await loadBlogEntries();
const { Content, headings } = await render(entry);
const social = await getImage({
  src: entry.data.heroImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
});
const canonicalPath = blogPostPath(entry.id);
const related = relatedArticles(
  entries.map((item) => toBlogPostMeta(item)),
  entry.id,
).flatMap((meta) => {
  const source = entries.find((item) => item.id === meta.id);
  if (!source) return [];
  return [
    {
      href: blogPostPath(meta.id),
      title: meta.title,
      description: meta.description,
      kindLabel: blogKindLabels[meta.kind],
      publishedAt: meta.publishedAt,
      publishedLabel: formatBlogDate(meta.publishedAt),
      image: source.data.heroImage,
      imageAlt: source.data.heroAlt,
    },
  ];
});
const components = {
  Figure,
  Gallery,
  Callout,
  Quote,
  YouTubeEmbed,
  ArticleCTA,
  UpcomingEvents,
  RelatedVenue,
};
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={canonicalPath}
  kindLabel={blogKindLabels[entry.data.kind]}
  publishedAt={entry.data.publishedAt}
  publishedLabel={formatBlogDate(entry.data.publishedAt)}
  updatedAt={entry.data.updatedAt}
  updatedLabel={entry.data.updatedAt ? formatBlogDate(entry.data.updatedAt) : undefined}
  hero={entry.data.heroImage}
  heroAlt={entry.data.heroAlt}
  heroCaption={entry.data.heroCaption}
  heroCredit={entry.data.heroCredit}
  heroCreditUrl={entry.data.heroCreditUrl}
  headings={headings}
  jsonLd={buildBlogPostingJsonLd({
    title: entry.data.title,
    description: entry.data.description,
    path: canonicalPath,
    publishedAt: entry.data.publishedAt,
    updatedAt: entry.data.updatedAt,
    image: social.src,
  })}
  analytics={{
    page_type: 'article',
    article_slug: entry.id,
    article_kind: entry.data.kind,
  }}
  socialImage={social.src}
  socialImageAlt={entry.data.heroAlt}
  socialImageWidth={1200}
  socialImageHeight={630}
  socialImageType="image/jpeg"
  publishedTime={entry.data.publishedAt}
  modifiedTime={entry.data.updatedAt}
>
  <Content components={components} />
  <ArticleCTA kind="whatsapp" />
  <RelatedArticles slot="related" items={related} />
</ArticleLayout>
