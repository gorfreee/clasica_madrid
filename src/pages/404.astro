---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada" description="Esa página no existe en Clásica Madrid." canonicalPath="/404">
  <section class="not-found">
    <p class="not-found__number" aria-hidden="true">404</p>
    <div>
      <p class="eyebrow">Página no encontrada</p>
      <h1>Aquí no suena nada.</h1>
      <p>Puede que el enlace esté incompleto o que esta página ya no exista.</p>
      <a class="primary-action" href="/">Volver a la agenda <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>
