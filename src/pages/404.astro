---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada" description="Esa página no existe en Clásica Madrid." canonicalPath="/404">
  <header class="error-page">
    <p class="eyebrow">Fuera de programa</p>
    <div class="error-page__code" aria-hidden="true">404</div>
    <h1>Esta página<br />no está en cartel.</h1>
    <p>Puede que el enlace esté incompleto o que la página haya cambiado.</p>
    <a class="button-link" href="/">Volver a la agenda</a>
  </header>
</Layout>
