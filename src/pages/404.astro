---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada" description="Esa página no existe en Clásica Madrid." canonicalPath="/404">
  <header class="page-header">
    <p class="eyebrow">404</p>
    <h1>No encontramos esa página</h1>
    <p class="lede">
      Puede que el concierto ya no esté publicado o que el enlace esté incompleto.
    </p>
    <p class="detail__actions">
      <a class="action" href="/">Volver a la agenda</a>
    </p>
  </header>
</Layout>
