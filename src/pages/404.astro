---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada" description="Esa página no existe en Clásica Madrid." canonicalPath="/404">
  <header class="page-header page-header--error">
    <p class="folio">404</p>
    <h1>No encontramos esa página</h1>
    <p class="lede">El enlace puede estar incompleto o apuntar a una página que ya no existe.</p>
    <p><a class="text-action" href="/">Volver a la agenda <span aria-hidden="true">→</span></a></p>
  </header>
</Layout>
