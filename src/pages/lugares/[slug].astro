---
import Layout from '../../layouts/Layout.astro';
import AgendaItem from '../../components/AgendaItem.astro';
import { loadVenuePage, loadVenueSlugs } from '../../lib/presentation/site.ts';

export async function getStaticPaths() {
  const slugs = await loadVenueSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
if (!slug) {
  throw new Error('Falta el slug del lugar');
}
const model = await loadVenuePage(slug);
if (!model) {
  throw new Error(`Lugar público no encontrado: ${slug}`);
}
const mapQuery = [model.address, model.municipality].filter(Boolean).join(', ');
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
---

<Layout title={model.title} description={model.description} canonicalPath={model.canonicalPath}>
  <article class="detail">
    <header class="page-header">
      <p class="eyebrow"><span>Lugar</span><span>{model.areaLabel}</span></p>
      <h1>{model.name}</h1>
      <p class="lede">
        {model.showMunicipality ? `${model.municipality} · ` : ''}
        {model.areaLabel}
      </p>
      {model.address && <p class="detail__address">{model.address}</p>}
      <div class="venue-actions">
        {model.url && <a href={model.url} rel="noopener noreferrer">Sitio del espacio <span aria-hidden="true">↗</span></a>}
        {mapQuery && <a href={mapsUrl} rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>}
      </div>
    </header>

    <section class="venue-programme" aria-labelledby="proximos-titulo">
      <div class="venue-programme__heading">
        <p>Programa</p>
        <h2 id="proximos-titulo">Próximos conciertos</h2>
      </div>
      {
        model.upcoming.length === 0 ? (
          <p>No hay conciertos próximos publicados en este espacio.</p>
        ) : (
          <div class="agenda-day__list">
            {model.upcoming.map((item) => <AgendaItem item={item} showDate />)}
          </div>
        )
      }
    </section>
  </article>
</Layout>
