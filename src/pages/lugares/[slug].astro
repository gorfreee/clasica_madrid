---
import Layout from '../../layouts/Layout.astro';
import AgendaItem from '../../components/AgendaItem.astro';
import HeroMotif from '../../components/HeroMotif.astro';
import PlaceAddress from '../../components/PlaceAddress.astro';
import { loadVenuePage, loadVenueSlugs } from '../../lib/presentation/site.ts';
import { VENUES_INDEX_PATH } from '../../lib/presentation/urls.ts';

export async function getStaticPaths() {
  const slugs = await loadVenueSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
if (!slug) {
  throw new Error('Falta el slug del lugar');
}
const model = await loadVenuePage(slug);
if (!model) {
  throw new Error(`Lugar público no encontrado: ${slug}`);
}
---

<Layout title={model.title} description={model.description} canonicalPath={model.canonicalPath} jsonLd={model.jsonLd}>
  <article class="detail venue-detail">
    <header class="detail-hero detail-hero--venue">
      <a class="eyebrow" href={VENUES_INDEX_PATH}>Lugar / {model.areaLabel}</a>
      <h1>{model.name}</h1>
      <div class="venue-detail__practical">
        {model.placeAddress ? (
          <PlaceAddress address={model.placeAddress} variant="hero" />
        ) : (
          <p class="venue-detail__locality">{model.municipality}</p>
        )}
        {model.url && <a class="text-link" href={model.url} rel="noopener noreferrer">Web oficial ↗</a>}
      </div>
      <HeroMotif variant="venue" class="detail-hero__motif" />
    </header>

    <section class="detail-section venue-programme" aria-labelledby="proximos-titulo">
      <div class="section-heading">
        <h2 id="proximos-titulo">Próximos conciertos</h2>
      </div>
      {
        model.upcoming.length === 0 ? (
          <p class="quiet-state">No hay conciertos próximos publicados en este espacio.</p>
        ) : (
          <div class="agenda-day__list">
            {model.upcoming.map((item) => <AgendaItem item={item} />)}
          </div>
        )
      }
    </section>
  </article>
</Layout>
