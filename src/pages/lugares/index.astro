---
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import HeroMotif from '../../components/HeroMotif.astro';
import { loadVenuesIndex } from '../../lib/presentation/site.ts';

const model = await loadVenuesIndex();
---

<Layout title={model.title} description={model.description} canonicalPath={model.canonicalPath}>
  <header class="section-intro section-intro--venues">
    <div class="section-intro__copy">
      <Eyebrow label="Lugares" />
      <h1>La ciudad<br />como escenario.</h1>
      <p class="lede">Teatros, auditorios, iglesias y otros espacios donde escuchar música clásica en Madrid.</p>
    </div>
    <HeroMotif variant="venues" class="section-intro__motif" />
  </header>

  <label class="venue-search">
    <span>Buscar un lugar</span>
    <input type="search" placeholder="Nombre o municipio" data-venue-search />
  </label>

  {
    model.isEmpty ? (
      <EmptyState
        title="Todavía no hay lugares publicados"
        body="Cuando el catálogo tenga espacios verificados, aparecerán aquí."
      />
    ) : (
      <ul class="venue-list">
        {model.venues.map((venue, index) => (
          <li data-venue-entry data-search={`${venue.name} ${venue.municipality}`.toLowerCase()}>
            <a href={venue.href}>
              <span class="venue-list__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="venue-list__name">{venue.name}</span>
              {venue.nextDateLabel && <span class="venue-list__next">Próximo / {venue.nextDateLabel}</span>}
              <span class:list={['venue-list__meta', { 'venue-list__meta--inactive': venue.upcomingCount === 0 }]}>
                {venue.showMunicipality && (
                  <span class="venue-list__municipality">{venue.municipality}</span>
                )}
                <span class="venue-list__programme">{venue.programmeLabel}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <script>
    const input = document.querySelector<HTMLInputElement>('[data-venue-search]');
    input?.addEventListener('input', () => {
      const query = input.value.trim().toLocaleLowerCase('es');
      for (const entry of document.querySelectorAll<HTMLElement>('[data-venue-entry]')) {
        entry.hidden = Boolean(query && !entry.dataset.search?.includes(query));
      }
    });
  </script>
</Layout>
