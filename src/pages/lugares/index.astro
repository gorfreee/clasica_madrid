---
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { loadVenuesIndex } from '../../lib/presentation/site.ts';
import { venueUpcomingSummary } from '../../lib/presentation/venue.ts';

const model = await loadVenuesIndex();
---

<Layout title={model.title} description={model.description} canonicalPath={model.canonicalPath}>
  <header class="page-header">
    <p class="eyebrow">Lugares</p>
    <h1>Dónde suena</h1>
    <p class="lede">Espacios con programación próxima, ordenados por la fecha más cercana.</p>
  </header>

  {
    model.isEmpty ? (
      <EmptyState
        title="Todavía no hay lugares con conciertos publicados"
        body="Cuando el catálogo tenga eventos verificados, sus espacios aparecerán aquí."
      />
    ) : (
      <>
        <div class="venue-toolbar">
          <label class="field">
            <span>Buscar un lugar</span>
            <input type="search" data-venue-filter placeholder="Nombre o municipio" />
          </label>
        </div>
        <p class="empty-state" data-venue-filter-empty hidden>Ningún lugar coincide con esa búsqueda.</p>
        <ul class="venue-list">
          {model.venues.map((venue) => (
            <li
              class="venue-list__item"
              data-venue-row={`${venue.name} ${venue.municipality}`}
            >
              <a href={venue.href}>
                <span class="venue-list__name">{venue.name}</span>
                <span class="venue-list__count">{venueUpcomingSummary(venue.upcomingCount)}</span>
                <span class="venue-list__meta">
                  {venue.showMunicipality ? `${venue.municipality} · ` : ''}
                  {venue.nextDateLabel ? `próximo ${venue.nextDateLabel}` : ''}
                </span>
              </a>
            </li>
          ))}
        </ul>
        {
          model.inactiveVenues.length > 0 && (
            <details class="catalog-rest" id="todos-los-lugares">
              <summary>Ver todos los lugares</summary>
              <ul class="venue-list">
                {model.inactiveVenues.map((venue) => (
                  <li
                    class="venue-list__item"
                    data-venue-row={`${venue.name} ${venue.municipality}`}
                  >
                    <a href={venue.href}>
                      <span class="venue-list__name">{venue.name}</span>
                      <span class="venue-list__count">Sin próximos</span>
                      <span class="venue-list__meta">
                        {venue.showMunicipality ? venue.municipality : venue.areaLabel}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )
        }
        <script>
          import { initVenueIndex } from '../../lib/presentation/agenda-client.ts';
          initVenueIndex();
        </script>
      </>
    )
  }
</Layout>
