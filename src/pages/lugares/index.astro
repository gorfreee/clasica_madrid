---
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { loadVenuesIndex } from '../../lib/presentation/site.ts';
import { venueUpcomingSummary } from '../../lib/presentation/venue.ts';

const model = await loadVenuesIndex();
---

<Layout title={model.title} description={model.description} canonicalPath={model.canonicalPath}>
  <header class="page-header">
    <p class="eyebrow"><span>Lugares</span><span>Por próxima actividad</span></p>
    <h1>Escenarios de Madrid</h1>
    <p class="lede">Salas, teatros, iglesias y espacios con música clásica próxima.</p>
  </header>

  {
    model.isEmpty ? (
      <EmptyState
        title="Todavía no hay lugares con conciertos publicados"
        body="Cuando el catálogo tenga eventos verificados, sus espacios aparecerán aquí."
      />
    ) : (
      <ol class="venue-list">
        {model.venues.map((venue, index) => (
          <li>
            <a href={venue.href}>
              <span class="venue-list__number">{String(index + 1).padStart(2, '0')}</span>
              <span class="venue-list__name">{venue.name}</span>
              <time class="venue-list__next" datetime={venue.nextDate}>{venue.nextDateLabel}</time>
              <span class="venue-list__meta">
                {venue.showMunicipality ? `${venue.municipality} · ` : ''}
                {venueUpcomingSummary(venue.upcomingCount)}
              </span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
</Layout>
