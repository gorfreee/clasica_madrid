---
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import PageHero from '../../components/PageHero.astro';
import SearchIcon from '../../components/SearchIcon.astro';
import { loadVenuesIndex } from '../../lib/presentation/site.ts';
import { venueCountLabel } from '../../lib/presentation/labels.ts';

const model = await loadVenuesIndex();
---

<Layout title={model.title} description={model.description} canonicalPath={model.canonicalPath}>
  <PageHero layout="index" motif="venues">
    <Eyebrow label="Lugares" />
    <h1>La ciudad<br />como escenario</h1>
    <p class="lede">Teatros, auditorios, iglesias y otros espacios donde escuchar música clásica en Madrid</p>
  </PageHero>

  {
    model.isEmpty ? (
      <EmptyState
        title="Todavía no hay lugares publicados"
        body="Cuando el catálogo tenga espacios verificados, aparecerán aquí"
      />
    ) : (
      <>
        {/* Contrato UI interno: [data-venue-search], [data-venue-search-clear], [data-venue-count], [data-venue-no-results], [data-venue-list] y [data-venue-entry] los usa venue-search-client.ts. */}
        <div class="venue-search">
          <div class="search-bar">
            <label class="search-bar__field">
              <span class="visually-hidden">Buscar un lugar</span>
              <span class="search-bar__icon" aria-hidden="true">
                <SearchIcon />
              </span>
              <input
                type="search"
                placeholder="Busca un lugar o municipio"
                autocomplete="off"
                spellcheck="false"
                enterkeyhint="search"
                data-venue-search
              />
            </label>
            <button type="button" class="search-bar__clear" data-venue-search-clear hidden aria-label="Limpiar búsqueda">
              <span aria-hidden="true">×</span>
            </button>
          </div>
          <p class="venue-search__count" data-venue-count>{venueCountLabel(model.venues.length)}</p>
        </div>

        <p class="venue-search__empty" data-venue-no-results hidden role="status" aria-live="polite"></p>

        <ul class="venue-list" data-venue-list>
          {model.venues.map((venue, index) => (
            <li data-venue-entry data-search={venue.searchHaystack}>
              <a href={venue.href}>
                <span class="venue-list__index">{String(index + 1).padStart(2, '0')}</span>
                <span class="venue-list__name">{venue.name}</span>
                {venue.nextDateLabel && <span class="venue-list__next">Próximo / {venue.nextDateLabel}</span>}
                <span class:list={['venue-list__meta', { 'venue-list__meta--inactive': venue.upcomingCount === 0 }]}>
                  {venue.showMunicipality && (
                    <span class="venue-list__municipality">{venue.municipality}</span>
                  )}
                  <span class="venue-list__programme">{venue.programmeLabel}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <script>
          import { initVenueSearch } from '../../lib/presentation/venue-search-client.ts';
          initVenueSearch();
        </script>
      </>
    )
  }
</Layout>
