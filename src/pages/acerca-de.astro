---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { ABOUT_PATH } from '../lib/presentation/urls.ts';
---

<Layout
  title="Acerca de"
  description="Clásica Madrid reúne en una sola agenda conciertos y eventos de música clásica en Madrid."
  canonicalPath={ABOUT_PATH}
>
  <header class="page-label">
    <Eyebrow label="Acerca de" />
  </header>

  <section class="about-copy" aria-labelledby="about-title">
    <h1 id="about-title">Muchas fuentes, una sola agenda</h1>
    <div class="about-copy__text">
      <p>
        La información sobre conciertos está repartida entre teatros, auditorios, iglesias,
        conservatorios, universidades, fundaciones y muchas otras entidades. Clásica Madrid nace
        para hacerla más fácil de encontrar y consultar.
      </p>
      <p>
        El objetivo es ofrecer una agenda clara y amplia, desde las grandes programaciones hasta
        conciertos pequeños, gratuitos o menos visibles, siempre con la información presentada de
        forma sencilla y consistente.
      </p>
    </div>
  </section>
</Layout>

<style>
  .about-copy {
    display: grid;
    grid-template-columns: minmax(13rem, .55fr) minmax(0, 1fr);
    gap: 3rem;
    max-width: 58rem;
    margin-top: 2.25rem;
    padding: 2.25rem 0 1rem;
    border-top: 2px solid var(--ink);
  }

  .about-copy h1 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    letter-spacing: var(--type-tracking-heading);
    line-height: .98;
  }

  .about-copy__text {
    max-width: 38rem;
  }

  .about-copy__text p {
    margin: 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.55;
  }

  .about-copy__text p + p {
    margin-top: 1.35rem;
  }

  @media (max-width: 620px) {
    .about-copy {
      grid-template-columns: 1fr;
      gap: 1.4rem;
      margin-top: 1.75rem;
    }
  }
</style>
