  "cards": [
    {
      "dot": "emerald",
      "title": "Determinismo primero",
      "items": [
        "El pool se ejecuta en Actions y llama a APIs de IA: fallback, cuotas y política de coste cero.",
        "Reglas, identidad y reconciliación deterministas; la IA interpreta hechos, no busca ni inventa."
      ]
    },
    {
      "dot": "violet",
      "title": "Git como fuente de verdad",
      "items": [
        "Sin base de datos productiva para servir la agenda; data/** conserva el histórico.",
        "Escritura validada local → PR de datos → CI → merge → despliegue desde main."
      ]
    },
    {
      "dot": "amber",
      "title": "Cloudflare: auxiliares integrados",
      "items": [
        "Pages Function: contacto con Turnstile y Email Service, sin persistencia.",
        "Rebuild diario: Cron Worker → Deploy Hook; Cron y Email Routing se configuran fuera del repo."
      ]
    }
